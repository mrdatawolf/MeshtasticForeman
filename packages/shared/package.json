{
  "name": "@foreman/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write package.json vitest.config.ts \"src/**/*.ts\"",
    "format:check": "prettier --check package.json vitest.config.ts \"src/**/*.ts\""
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "zod": "^3.24.0"
  }
}
