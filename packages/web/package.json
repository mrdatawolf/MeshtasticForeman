{
  "name": "@foreman/web",
  "version": "0.7.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write package.json index.html vite.config.ts \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check package.json index.html vite.config.ts \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@foreman/shared": "workspace:*",
    "@turf/helpers": "^7.3.4",
    "@turf/union": "^7.3.4",
    "maplibre-gl": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.29.1",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  }
}
