{
  "name": "meshtastic-foreman",
  "version": "0.8.3",
  "private": true,
  "description": "Persistent daemon + web UI for Meshtastic device management",
  "scripts": {
    "docs:dev": "pnpm --filter @foreman/docs dev",
    "docs:build": "pnpm --filter @foreman/docs build",
    "docs:preview": "pnpm --filter @foreman/docs preview",
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write eslint.config.mjs .prettierrc.json package.json && pnpm -r format",
    "format:check": "prettier --check eslint.config.mjs .prettierrc.json package.json && pnpm -r format:check",
    "test": "pnpm -r test",
    "cache:export": "pnpm --filter @foreman/daemon cache:export",
    "cache:import": "pnpm --filter @foreman/daemon cache:import",
    "build:web": "pnpm --filter @foreman/web build",
    "build:daemon": "node scripts/bundle-daemon.js",
    "electron:start": "electron electron-app",
    "electron:build": "node scripts/sync-version.js && electron-builder --config electron-builder.json",
    "build:installer": "pnpm run build:web && pnpm run build:daemon && pnpm run electron:build",
    "clean:dist": "node -e \"const fs=require('fs'); ['dist-electron','dist-daemon'].forEach(d=>{if(fs.existsSync(d)){fs.rmSync(d,{recursive:true,force:true});console.log('Cleaned: '+d)}})\""
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^39.8.8",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "8.65.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@meshtastic/core",
      "@meshtastic/transport-node-serial",
      "@serialport/bindings-cpp",
      "electron",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
