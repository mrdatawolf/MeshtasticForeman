# Meshtastic Foreman — API daemon systemd unit
#
# Starts start-api.sh on boot and keeps it running.
#
# Install:
#   sudo cp Samples/foreman-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now foreman-api.service
#
# Logs:
#   journalctl -u foreman-api.service -f
#
# Adjust before installing on another machine/user:
#   - User / Group        (Group=dialout is needed for serial port access to the Meshtastic device)
#   - WorkingDirectory / ExecStart paths
#   - PATH                (must point at the node/pnpm install used by this checkout; pnpm here is
#                          installed via nvm, which systemd does not source from .bashrc on its own)

[Unit]
Description=Meshtastic Foreman - API Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=patrick
Group=dialout
WorkingDirectory=/home/patrick/Documents/Github/MeshtasticForeman
Environment=PATH=/home/patrick/.nvm/versions/node/v24.16.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/bin
ExecStart=/home/patrick/Documents/Github/MeshtasticForeman/start-api.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
